local Players = game:GetService("Players")

local CharacterSignals = {}

local watchers = {}

local function disconnectAll(list)
	if not list then return end
	for _, conn in list do
		conn:Disconnect()
	end
	table.clear(list)
end

local function bindCharacter(watcher, character)
	disconnectAll(watcher.charConns)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		humanoid = character:WaitForChild("Humanoid", 10)
	end
	if not humanoid then
		warn("[CharacterSignals] humanoid never appeared for", watcher.player.Name)
		return
	end

	for signalName, callback in watcher.signals do
		local signal = humanoid[signalName]
		if typeof(signal) ~= "RBXScriptSignal" then
			warn(("[CharacterSignals] %s is not a valid Humanoid signal"):format(tostring(signalName)))
			continue
		end

		local conn = signal:Connect(function(...)
			if watcher.player.Character ~= character then return end
			callback(watcher.player, character, ...)
		end)
		table.insert(watcher.charConns, conn)
	end
end

local function cleanupWatcher(player)
	local watcher = watchers[player]
	if not watcher then return end

	disconnectAll(watcher.charConns)
	disconnectAll(watcher.playerConns)
	watchers[player] = nil
end

function CharacterSignals.Watch(player, signals)
	assert(typeof(player) == "Instance" and player:IsA("Player"), "Watch expects a Player")
	assert(type(signals) == "table", "Watch expects a signals table")

	cleanupWatcher(player)

	local watcher = {
		player = player,
		signals = signals,
		charConns = {},
		playerConns = {},
	}
	watchers[player] = watcher

	table.insert(watcher.playerConns, player.CharacterAdded:Connect(function(character)
		bindCharacter(watcher, character)
	end))

	table.insert(watcher.playerConns, player.CharacterRemoving:Connect(function()
		disconnectAll(watcher.charConns)
	end))

	if player.Character then
		bindCharacter(watcher, player.Character)
	end
end

function CharacterSignals.Unwatch(player)
	cleanupWatcher(player)
end

Players.PlayerRemoving:Connect(cleanupWatcher)

return CharacterSignals
